# Copy to local.env (not committed) and set your own addresses. The values below are documentation examples.
# This machine's tailnet address (must be in 100.64.0.0/10), or 127.0.0.1 for SSH tunnels only.
SPEECH_BIND_IP=100.64.0.1
# Comma separated IPv4 addresses allowed to connect; 127.0.0.1 is always allowed.
SPEECH_ALLOWED_CLIENTS=100.64.0.2
